ENVIRONMENT=development
# Use the same Neon database as Django so chunks are written to/read from Django tables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCUMENT_STORAGE_ROOT=../backend-django/media
EMBEDDING_DIMENSIONS=384
EMBEDDING_PROVIDER=hash
LLM_PROVIDER=extractive
# Set these for provider-backed generation; defaults remain local/offline.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
USE_PGVECTOR=true
CHUNK_TOKEN_SIZE=900
CHUNK_TOKEN_OVERLAP=120
RETRIEVAL_THRESHOLD=0.18
RETRIEVAL_CACHE_TTL_SECONDS=1200
