DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Neon PostgreSQL connection string. Keep sslmode=require for hosted Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
RAG_SERVICE_URL=http://127.0.0.1:8001
RAG_TIMEOUT_SECONDS=60
MAX_DOCUMENT_UPLOAD_BYTES=20971520
USE_PGVECTOR=true
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Keep true for local single-process demos; use false when running a Celery worker.
CELERY_TASK_ALWAYS_EAGER=true
ANSWER_CACHE_TTL_SECONDS=1200
